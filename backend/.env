# LLM Gateway configuration (Phase 4).
#
# Copy to `.env` and adjust for your machine. All values here are read by
# app.llm.config.LLMSettings -- nothing is hard-coded in the gateway or
# provider. Defaults below target a dev machine with 24 GB system RAM and
# 6 GB VRAM: two smaller local models that alternate through the same GPU,
# never resident at the same time (MAX_LLM_CONCURRENCY=1, MODEL_KEEP_ALIVE=0).

OLLAMA_BASE_URL=http://localhost:11434

# Reasoning model (Qwen3 4B) -- requirements, architecture, planning,
# decomposition, management, reasoning, error analysis, integration
# reasoning, routing.
OLLAMA_REASONING_MODEL=qwen3:4b

# Coding model (Qwen2.5-Coder 7B, Q4 quantization) -- coding, debugging,
# code review, test generation, refactoring, documentation, configuration.
OLLAMA_CODING_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# Per-request timeout, in seconds.
LLM_REQUEST_TIMEOUT=300

# Only one model runs inference at a time -- required on 6 GB VRAM, since
# both models can't comfortably stay resident together.
MAX_LLM_CONCURRENCY=1

# Unload a model from VRAM immediately after each request completes, so
# switching between the reasoning and coding models doesn't fight over the
# same 6 GB of VRAM. Raise this (in seconds) if you'd rather trade VRAM
# headroom for faster back-to-back calls to the *same* model.
MODEL_KEEP_ALIVE=0

# ---------------------------------------------------------------------------
# Persistence (Phase 17). Read by app.db.config.DatabaseSettings.
# ---------------------------------------------------------------------------

# SQLite for local development (default). For PostgreSQL in production use:
#   DATABASE_URL=postgresql+asyncpg://ahsea:password@localhost:5432/ahsea
DATABASE_URL=sqlite+aiosqlite:///./ahsea.db

# Log every SQL statement (verbose; local debugging only).
DATABASE_ECHO=false

# Connection pool sizing (ignored for SQLite).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# Safety switch: LLM prompt/response text is NEVER persisted unless this is
# explicitly set to true, and even then only what a caller explicitly opts
# to pass into PersistenceService.record_llm_request(..., prompt=...).
AHSEA_PERSIST_LLM_PROMPTS=false
