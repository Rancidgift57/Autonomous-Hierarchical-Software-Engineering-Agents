# Base URL of the AHSEA FastAPI control plane (Phase 16/17 backend).
# Server-only: the browser never talks to this directly, it goes through
# the Next.js proxy route at /api/proxy/*, so this value never ships to
# the client bundle.
API_BASE_URL=http://localhost:8000

# Optional. Only set if the backend has AHSEA_REQUIRE_API_KEY=true.
# Server-only — attached to outgoing requests inside app/api/proxy, never
# sent to or readable by the browser.
AHSEA_API_KEY=

# Phase 19 — /ws/projects/{project_id}. Unlike the two variables above,
# these ARE shipped to the browser bundle: a WebSocket can't be proxied
# through the app/api/proxy Route Handler (no upgrade support without a
# custom server), so the browser connects to the backend directly.
#
# Base URL the browser uses to open the socket (ws:// or wss://).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Only set this if AHSEA_REQUIRE_API_KEY=true AND it's acceptable for this
# key to be visible in the browser bundle / WebSocket handshake URL (e.g.
# local development, or a backend already behind a network boundary the
# browser is trusted inside of). For a public-facing deployment, put a
# real reverse-proxy WebSocket pass-through in front of /ws/ instead of
# widening this key's exposure.
NEXT_PUBLIC_WS_API_KEY=
